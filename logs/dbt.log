    create or replace table `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset_mart_nyc_crashes`.`mart_high_risk_location`
      
    
    

    
    OPTIONS()
    as (
      # Most common streets where crashes happen in Nyc 


SELECT
    collision_id,
    FORMAT_DATE('%A', crash_date) AS day_name,
    FORMAT_DATE('%B', crash_date) AS month_name,
    crash_time,
    borough,
    on_street_name,
    location,
    number_of_persons_injured,
    number_of_persons_killed,
    number_of_pedestrians_injured,
    number_of_pedestrians_killed,
    number_of_cyclist_injured,
    number_of_cyclist_killed,
    number_of_pedestrians_injured,
    number_of_pedestrians_killed
    vehicle_type_code_1,
    contributing_factor_vehicle_1,
    COUNT(*) AS total_crashes
FROM `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset_stg_nyc_crashes`.`stg_2025_nyc_crashes`
GROUP BY
    FORMAT_DATE('%A', crash_date),
    FORMAT_DATE('%B', crash_date),
    crash_time,
    borough,
    on_street_name,
    location,
    number_of_persons_injured,
    number_of_persons_killed,
    number_of_pedestrians_injured,
    number_of_pedestrians_killed,
    number_of_cyclist_injured,
    number_of_cyclist_killed,
    number_of_pedestrians_injured,
    number_of_pedestrians_killed
    vehicle_type_code_1,
    contributing_factor_vehicle_1
ORDER BY total_crashes DESC
    );
  
