    create or replace table `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset_mart_monthly_crashes`.`mart_monthly_crashes`
      
    
    

    
    OPTIONS()
    as (
      # Monthly crashes in Nyc 

SELECT
  FORMAT_DATE('%B', crash_date) AS month_name,
  COUNT(crash_date) AS total_crashes
FROM
  `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset_stg_2025_nyc_crashes`.`stg_2025_nyc_crashes`
GROUP BY month_name
ORDER BY COUNT(crash_date) DESC
    );
  
