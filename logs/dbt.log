    create or replace table `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset_mart_nyc_crashes`.`mart_daily_crashes`
      
    
    

    
    OPTIONS()
    as (
      # Which day of the week has the highest number of accidents in Nyc.

SELECT
  FORMAT_DATE('%A', crash_date) AS day_name,
  COUNT(crash_date) AS total_crashes
FROM
  `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset_stg_nyc_crashes`.`stg_2025_nyc_crashes`
GROUP BY day_name
ORDER BY COUNT(crash_date) DESC
    );
  
