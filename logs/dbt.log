    create or replace table `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset_mart_monthly_crashes`.`total_crashes_per_time_of_day`
      
    
    

    
    OPTIONS()
    as (
      # Monthly crashes in Nyc 

SELECT
  crash_time,
  CASE
    WHEN crash_time < 01:00:00 THEN '12am - 12:59am'
    WHEN crash_time BETWEEN 12:59:00 AND 02:00:00 THEN '1am - 1:59am'
    WHEN crash_time BETWEEN 01:59:00 AND 03:00:00 THEN '2am - 2:59am'
    WHEN crash_time BETWEEN 02:59:00 AND 04:00:00 THEN '3am - 3:59am'
    WHEN crash_time BETWEEN 03:59:00 and 05:00:00 THEN '4am - 4:59am'
    WHEN crash_time BETWEEN 04:59:00 AND 06:00:00 THEN '5am - 5:59am'
    WHEN crash_time BETWEEN 05:59:00 AND 07:00:00 THEN '6am - 6:59am'
    WHEN crash_time BETWEEN 06:59:00 AND 08:00:00 THEN '7am - 7:59am'
    WHEN crash_time BETWEEN 07:59:00 AND 09:00:00 THEN '8am - 8:59am'
    WHEN crash_time BETWEEN 08:59:00 AND 10:00:00 THEN '9am - 9:59am'
    WHEN crash_time BETWEEN 09:59:00 AND 11:00:00 THEN '10am - 10:59am'
    WHEN crash_time BETWEEN 10:59:00 AND 12:00:00 THEN '11am - 11:59am'
    WHEN crash_time BETWEEN 11:59:00 AND 13:00:00 THEN '12pm - 12:59pm'
    WHEN crash_time BETWEEN 12:59:00 AND 14:00:00 THEN '1pm - 1:59pm'
    WHEN crash_time BETWEEN 13:59:00 AND 15:00:00 THEN '2pm - 2:59pm'
    WHEN crash_time BETWEEN 14:59:00 AND 16:00:00 THEN '3pm - 3:59pm'
    WHEN crash_time BETWEEN 15:59:00 AND 17:00:00 THEN '4pm - 4:59pm'
    WHEN crash_time BETWEEN 16:59:00 AND 18:00:00 THEN '5pm - 5:59pm'
    WHEN crash_time BETWEEN 17:59:00 AND 19:00:00 THEN '6pm - 6:59pm'
    WHEN crash_time BETWEEN 18:59:00 AND 20:00:00 THEN '7pm - 7:59pm'
    WHEN crash_time BETWEEN 19:59:00 AND 21:00:00 THEN '8pm - 8:59pm'
    WHEN crash_time BETWEEN 20:59:00 AND 22:00:00 THEN '9pm - 9:59pm'
    WHEN crash_time BETWEEN 21:59:00 AND 23:00:00 THEN '10pm - 10:59pm'
    WHEN crash_time BETWEEN 22:59:00 AND 24:00:00 THEN '11pm - 11:59pm'
    ELSE '12pm - 12:59pm' AS time_brucket,
  COUNT(crash_date) AS total_crashes
FROM
  `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset_stg_2025_nyc_crashes`.`stg_2025_nyc_crashes`
GROUP BY crash_time, time_brucket
ORDER BY COUNT(crash_date) DESC
    );
  
