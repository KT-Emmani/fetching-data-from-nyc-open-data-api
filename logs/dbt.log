        contributing_factor_vehicle_5,
        vehicle_type_code_5
    FROM `nyc-motor-vehicle-collision-12`.`nyc_motor_vehicle_collision_dataset`.`nyc_motor_crashes`
)
SELECT 
    *,
    current_timestamp() AS ingestion_timestamp 
FROM source
    );
  
